# TrendPilot AI — Environment Variables
# Copy this file to .env and fill in your values.

# Google Gemini API Key (required for content generation)
GEMINI_API_KEY=

# Klipy GIF/Meme API Key (optional — generation works without it)
# Get your key at: https://klipy.com (Partner Panel)
KLIPY_API_KEY=

# Legacy Tenor key — kept for backwards compatibility, Klipy takes priority
TENOR_API_KEY=

# SQLite database path
DATABASE_URL=sqlite:///./trendpilot.db

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

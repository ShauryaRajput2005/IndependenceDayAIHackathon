# TrendPilot AI — Environment Variables
# Copy this file to .env and fill in your values.

# Google Gemini API Key (required for content generation)
GEMINI_API_KEY=

# Tenor GIF API Key (optional — generation works without it)
TENOR_API_KEY=

# Tenor client key (identifies your app to Tenor)
TENOR_CLIENT_KEY=trendpilot

# SQLite database path
DATABASE_URL=sqlite:///./trendpilot.db

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
